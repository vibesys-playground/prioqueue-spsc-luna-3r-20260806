  #[inline]
  fn valid_word_mask(word_index: usize, capacity: usize) -> usize {
      let remaining = capacity.saturating_sub(word_index * WORD_BITS);
      if remaining >= WORD_BITS {
          usize::MAX
      } else if remaining == 0 {
          0
      } else {
          (1usize << remaining) - 1
      }
  }
  
